<!DOCTYPE html>
<head>
     <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">


    <title>Product Data</title>

    <style>
        /*Header Styling*/
        #pageHeader {background-color: black; text-align: center; align-content: center;}
        #Header {font-size: 1.5em; color: white;}
    </style>
</head>

<body>
    <!--Page Header, including home and checkout buttons-->
    <div class = "container" id = "pageHeader">
        <div class="row">
            <div class = "col-md-2"><a href = "../" class = "btn btn-secondary btn-sm">Home</a></div>
            <div class = "col-md-8" id="Header"><b>Kavanagh Electronics</b></div>
            <div class = "col-md-2" id="Cart"><a href = "/cart"  class = "btn btn-secondary btn-sm">Checkout</a></div>
        </div>
    </div> <br>
    
    <div class = "container">
        <div class = "row" >
            <!--Table showing product information - inject MySQL data to page-->
            <div class = "col-md-5 text-left">
                <h1 id = "product"><%= nameProd %></h1><br>
                <b>Product Information:</b><br>
                <table class = "table table-striped">
                    <tr>
                        <td>Manufacturer: </td>
                        <td id = "manufacturer"><%= prodManufacturer %></td>
                    </tr>
                    <tr>
                        <td>Model: </td>
                        <td id = "model"><%= prodModel %></td>
                    </tr>
                    <tr>
                        <td>Price: </td>
                        <td id = "price"><%= prodPrice %></td>
                    </tr>
                    <tr>
                        <td> Description: </td>
                        <td> <%= prodDescription %></td>
                    </tr>
                </table>
            </div>

            <!--Using mySQL data to render product image-->
            <div class = "col-md-7 text-end">
                <img src = "Images/prodImages/<%= prodImage %>" class = "img-fluid w-75 height:auto float-right" alt = "Product Image">
            </div>
        </div>
    </div><br>

    <!--'Add to cart' function-->
    <div class = "container">
        <select id="quantity" name = "quantity">
            <!--Dropdown menu to select desired QTY-->
            <option value = "0">0</option>
            <option value = "1" selected>1</option>
            <option value = "2">2</option>
            <option value = "3">3</option>
            <option value = "4">4</option>
            <option value = "5">5</option>
        </select>
        <!--When 'Add to Cart' clicked, price and QTY will be stored in localStorage-->
        <button onclick = "addToCart()">Add to Cart</button>
    </div>
        

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous">
    </script>
    
    
    
    <script>
        //Function to store items that are added to cart in localStorage.
        function addToCart(){
            //Set product variable to value displayed in HTML
            let product = document.getElementById("product").innerHTML;
            //Set quantity variable to number selected in dropdown 'add to cart' section. 
            let quantity = document.getElementById("quantity").value;
            //Set price variable to value displayed in HTML
            let price = document.getElementById("price").innerHTML;
            //Create an object using the quantity and price variables
            let quan_price = {p: price, q: quantity};
            //Store quantity and price object as string in localStorage
            localStorage.setItem(product, JSON.stringify(quan_price));
        }
    </script>
</body>