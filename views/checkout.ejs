<!DOCTYPE html>
<html>
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">

    <title>Checkout</title>
    <style>
      /*Form styling taken from WAD Week 12 lecture videos*/
      .checkout {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      label {
        display: block;
        margin-bottom: 5px;
      }
      input, select, textarea {
        display: block;
        margin-bottom: 10px;
        width: 100%;
      }
      button[type="submit"] {
        margin-top: 20px;
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 10px;
        border-radius: 5px;
        cursor: pointer;
      }
      input[type=submit] {
                width: 100%;
                background-color: rgb(239, 54, 53);
                color: white;
                padding: 14px;
                margin: 8px 0;
                border: none;
                border-radius: 4px;
                cursor: pointer;
            }
      /*Create styling for each object ID*/
      /* Black background color and centre aligmenet for header section*/
      #pageHeader {background-color: black; text-align: center; align-content: center;}
      /*"em font size and white text colour for header 'Kavanagh Electrical' text*/
      #Header {font-size: 2em; color: white;}
    </style>
  </head>
  <body>
    <!--Header container-->
    <div class = "container" id = "pageHeader">
        <div class="row">
        <div class = "col-md-2"><a href = "login.html" class = "btn btn-secondary btn-sm">Login & Order Summary</a></div>
        <div class = "col-lg-8" id="Header"><b>Kavanagh Electronics</b></div>
        <div class = "col-lg-2" id="Cart"><a href = "Home.html"  class = "btn btn-secondary btn-sm">Home</a></div>
        </div>
    </div>


  
    <div class="checkout">
      <h1>Checkout</h1>

      <h2 id="cart_items"></h2>
      <h2 id = "totalPrice"></h2>

        <!--Checkout form. All fields required before placing order.-->
      <form id = "checkoutForm">
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" required>

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" required>

        <label for="address">Address:</label>
        <textarea id="address" name="address" required></textarea>

        <label for="payment">Payment Method:</label>
        <select id="payment" name="payment" required>
          <option value="">Credit Card</option>
          <option value="paypal">PayPal</option>
          <option value="stripe">Stripe</option>
        </select>

        <input type = "submit" value = "Place Order"/></p>

      </form>
    </div>
  </body>
</html>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
<script>
  //Inititalise total cost = 0. This is the cost of the entire basket
  let totalPrice = 0;
  //iterate through each item in local storage and display everything in the cart
    for(i = 0; i < localStorage.length; i++)
    {
        //assign each key to variable product
        let product = localStorage.key(i);
        //Parse the price and QTY of each item back to an object
        let content = JSON.parse(localStorage.getItem(product));
        //if the quantity of the item is 0, output the result
        let totalCost = content.q * content.p;
        totalPrice += totalCost;
        //If there is items in the cart, display the item in the 'cart items' h2 header and the total price in the 'totalPrice' h2 header
        if(content.q > 0)
        {
            document.getElementById("cart_items").innerHTML +=  product + " : " + content.q + " = " + totalCost + "<br>";}
        
            document.getElementById("totalPrice").innerHTML = totalPrice;
        }

  //JS function to create an alert after submit button is clicked if all form fields are valid. addEventListener taken from https://developer.mozilla.org/en-US/docs/Web/API/HTMLFormElement/submit_event#:~:text=the%20user%20presses%20Enter%20while,validation%20triggers%20an%20invalid%20event.
  const form = document.getElementById('checkoutForm');
  form.addEventListener('submit', function(event){
    alert ("We have got your order! Thank you!")
  })
</script>